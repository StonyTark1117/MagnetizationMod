# Isolated game directories for the release smoke-test profiles (build.gradle:
# smokeServerMinimal / smokeClientNormal).
run-smoke-server/
run-smoke-client/
run-client-*/
run-simulated-coasters-track-styles-client/
run-large-world-repro/
# Persistent local manual-playtest saves. Their layouts are rebuilt by the
# development-only playtest presets, so binary world data stays out of Git.
run-playtest-lab/
run-playtest-survival/
run-playtest-automation/
run-playtest-automation-survival/
playtest-results/
# Isolated game directories for the GameTest run profiles.
run-gametest/
run-aeroportals-gametest/
run-immersive-aeronautics-gametest/
run-simulated-coasters-gametest/
run-*-gametest/
# Dev-world snapshots (scripts/test-world.sh). Large binaries; force-add a
# specific snapshot if you deliberately want to share it.
test-worlds/
gradle-app.setting
.gradletasknamecache

# Keep gradle wrapper artifacts
!gradle-wrapper.jar
!gradle-wrapper.properties

# IDE
.idea/
*.iml
.eclipse/
.classpath
.project
.settings/
out/

# Generated resources
*/src/generated/

# OS
.DS_Store
Thumbs.db

# Local Claude state (project memory, transcripts) — not for the repo
.claude/

