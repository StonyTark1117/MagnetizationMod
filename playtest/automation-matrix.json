{
  "schema": 1,
  "profiles": {
    "lab": {
      "gradleTask": "runPlaytestLabClient",
      "gameDirectory": "run-playtest-lab",
      "resetCommand": "/magnetization playtest lab reset",
      "stations": ["overview", "gallery", "electrolyzer", "tokamak", "fusion", "railgun", "dipoles", "automation", "golems", "ship", "portal", "thruster_exhaust", "gas_excitation", "gas_detector", "air_separator", "ion_thruster", "rare_earth", "ponder_tokamak", "ponder_railgun"]
    },
    "survival": {
      "gradleTask": "runPlaytestSurvivalClient",
      "gameDirectory": "run-playtest-survival",
      "resetCommand": "/magnetization playtest survival reset",
      "stations": ["overview", "electrolyzer", "tokamak", "fusion", "railgun", "golems"]
    }
  },
  "visualThreshold": 0.08,
  "videoStations": ["railgun", "ship", "portal", "thruster_exhaust"],
  "videoActions": {
    "railgun": "/magnetization playtest scenario railgun_auto",
    "ship": "/magnetization spawn_test_ship 4 magnetite",
    "portal": "/aeroportals teleport minecraft:the_nether",
    "thruster_exhaust": "/magnetization playtest scenario thruster_exhaust"
  },
  "stationActions": {
    "gas_detector": [
      "/item replace entity @s weapon.mainhand with magnetization:gas_detector",
      "/setblock ~2 ~ ~ magnetization:radon",
      "/tp @s ~ ~ ~ 0 -90"
    ],
    "ponder_tokamak": [
      "/ponder magnetization:tokamak_controller"
    ],
    "ponder_railgun": [
      "/ponder magnetization:railgun_emitter"
    ],
    "golems": [
      "/kill @e[type=magnetization:gallium_golem,distance=..16]",
      "/kill @e[type=magnetization:mr_fluid_golem,distance=..16]",
      "/kill @e[type=magnetization:magnetite_golem,distance=..16]",
      "/kill @e[type=magnetization:pyrrhotite_golem,distance=..16]",
      "/kill @e[type=magnetization:hematite_golem,distance=..16]",
      "/kill @e[type=magnetization:titanomagnetite_golem,distance=..16]",
      "/summon magnetization:gallium_golem ~-5 ~ ~",
      "/summon magnetization:mr_fluid_golem ~-3 ~ ~",
      "/summon magnetization:magnetite_golem ~-1 ~ ~",
      "/summon magnetization:pyrrhotite_golem ~1 ~ ~",
      "/summon magnetization:hematite_golem ~3 ~ ~",
      "/summon magnetization:titanomagnetite_golem ~5 ~ ~"
    ]
  },
  "itemUseStations": ["gas_detector"],
  "closeAfterCaptureStations": ["ponder_tokamak", "ponder_railgun"],
  "guiStations": ["electrolyzer", "tokamak", "fusion", "railgun", "dipoles", "air_separator"],
  "fatalLogPatterns": "/(?:ERROR|FATAL)\\]|Missing textures? in model|Unable to load model|assert(?:ion)? failed"
}
